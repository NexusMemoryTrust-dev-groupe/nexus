# Dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output
dist/
build/
target/
out/

# Tauri
src-tauri/target/
src-tauri/WixTools/
src-tauri/Frameworks/
src-tauri/**/*.msi
src-tauri/**/*.exe
src-tauri/**/*.dmg
src-tauri/**/*.app
src-tauri/**/*.deb
src-tauri/**/*.AppImage
src-tauri/**/*.appimage

# Vite
*.local

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Rust
**/*.rs.bk
# Cargo.lock is committed on purpose: Nexus is a binary application, not a
# library, and lockfiles make release builds reproducible.

# TypeScript
*.tsbuildinfo

# Benchmarks (generated HTML reports)
src-tauri/target/criterion/

# SQLite databases
*.db
*.db-shm
*.db-wal

# Downloaded binaries (npm package)
npm-package/bin/*.exe
npm-package/bin/nexus

# FastEmbed model cache
src-tauri/.fastembed_cache/

# OpenCode runtime state
src-tauri/.omo/
.omo/

# Test artifacts
test-results/
playwright-report/

# OS files
Desktop.ini
