{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Nexus",
  "version": "1.0.1",
  "identifier": "com.nexus.memorytrust",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Memory Trust",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Nexus Memory Trust",
    "homepage": "https://github.com/NexusMemoryTrust-dev-groupe/nexus",
    "shortDescription": "AI Memory Operating System",
    "longDescription": "Nexus Memory Trust — knowledge graph and context engine that feeds AI assistants a compressed, ranked context package instead of raw files.",
    "category": "Productivity",
    "licenseFile": "../LICENSE-installer.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Nexus Memory Trust"
      }
    }
  }
}
